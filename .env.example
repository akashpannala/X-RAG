# X-RAG — unified provider config (local / ssh VPS / online) — no Docker
# Copy to .env and fill only the providers you use. App auto-detects.

# --- App ---
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-in-env
JWT_EXPIRE_MIN=480
DEFAULT_MODE_BY_GROUP={"hr":"quick","eng":"deep","public":"quick"}
UPLOAD_DIR=data/uploads
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- LLM ---
# groq | ollama | llama.cpp | openai | anthropic
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=sk-paste-your-groq-key-here

# Local LLM examples (uncomment one):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1:8b-q4_0
# LLM_API_KEY=

# LLM_PROVIDER=llama.cpp
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# --- Embeddings ---
# bge | jina | voyage | cohere | choreo
EMBED_PROVIDER=bge
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=

# Remote embedding examples (uncomment one):
# EMBED_PROVIDER=jina
# EMBED_BASE_URL=https://api.jina.ai/v1
# EMBED_MODEL=jina-embeddings-v3
# EMBED_API_KEY=jina_...

# EMBED_PROVIDER=voyage
# EMBED_BASE_URL=https://api.voyageai.com/v1
# EMBED_MODEL=voyage-3-large
# EMBED_API_KEY=...

# EMBED_PROVIDER=cohere
# EMBED_BASE_URL=https://api.cohere.ai/v1
# EMBED_MODEL=embed-english-v3.0
# EMBED_API_KEY=...

# --- Vector Store (Qdrant only) ---
VECTOR_BASE_URL=http://localhost:6333
VECTOR_API_KEY=
VECTOR_COLLECTION=offline_rag
# For Qdrant Cloud:
# VECTOR_BASE_URL=https://xxx.qdrant.io
# VECTOR_API_KEY=...

# --- Reranker ---
# minilm | jina | bge
RERANK_PROVIDER=minilm
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL=jina-reranker-m0
RERANK_API_KEY=

# Jina reranker example:
# RERANK_PROVIDER=jina
# RERANK_BASE_URL=https://api.jina.ai/v1
# RERANK_MODEL=jina-reranker-m0
# RERANK_API_KEY=jina_...

# Local BGE-reranker example:
# RERANK_PROVIDER=bge

# --- Database (SQL) ---
# sqlite | postgres | supabase
DB_PROVIDER=sqlite
DB_URL=
DB_PATH=data/meta.db

# Postgres/Supabase example:
# DB_PROVIDER=supabase
# DB_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# DB_PATH=

# Local Postgres example:
# DB_PROVIDER=postgres
# DB_URL=postgresql://user:pass@localhost:5432/xrag
# DB_PATH=