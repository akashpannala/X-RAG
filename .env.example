# X-RAG — aws-deploy config (API-only, pgvector-only, no local fallbacks)
# Copy to .env and fill the required remote keys/URLs.
#
# Required on this branch:
#   - remote LLM       (Groq / OpenAI / Anthropic)
#   - remote embeddings (Jina / Voyage / Cohere)
#   - remote reranker   (Jina)
#   - Postgres/Supabase + pgvector (DB_URL)
# Local providers (Ollama/llama.cpp, BGE embeddings, MiniLM/BGE rerankers,
# SQLite metadata, Qdrant) are intentionally unsupported. Missing models,
# API limits, and database failures are surfaced as explicit errors.

# --- App ---
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-in-env
JWT_EXPIRE_MIN=480
DEFAULT_MODE_BY_GROUP={"hr":"quick","eng":"deep","public":"quick"}
UPLOAD_DIR=data/uploads

# --- LLM (remote only) ---
# groq | openai | anthropic
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=sk-paste-your-groq-key-here

# --- Guardrails ---
# NeMo Guardrails input rail uses the remote LLM above.
# Set to 0 to skip NeMo and use the local regex screen only.
NEMO_GUARD=1

# --- Embeddings (remote only) ---
# jina | voyage | cohere
EMBED_PROVIDER=jina
EMBED_BASE_URL=https://api.jina.ai/v1
EMBED_MODEL=jina-embeddings-v3
EMBED_API_KEY=jina_...

# --- Reranker (remote only) ---
# jina only on aws-deploy (no local BGE/MiniLM fallback)
RERANK_PROVIDER=jina
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL=jina-reranker-m0
RERANK_API_KEY=jina_...

# --- Database + vector store (Postgres/Supabase + pgvector) ---
# postgres | supabase
# Use the Supabase IPv4 pooler — the direct db host is IPv6-only.
DB_PROVIDER=supabase
DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_PATH is only used by the unit-test suite (DB_PROVIDER=sqlite).
DB_PATH=data/meta.db

# Enable pgvector once per database (Supabase also exposes it in the dashboard):
#   CREATE EXTENSION IF NOT EXISTS vector;

# --- Container deploy (docker compose) ---
# DOMAIN=xrag-<name>.duckdns.org
# XRAG_DATA_DIR=/mnt/xrag/data
# XRAG_MODELS_DIR=/mnt/xrag/models
# XRAG_PORT=8001
# SEED=1
