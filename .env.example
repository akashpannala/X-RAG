# Phase 1 — local dev defaults (Groq API now, Ollama for offline gate)
LLM_PROVIDER=groq
GROQ_API_KEY=sk-paste-your-groq-key-here
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-q4_0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=offline_rag
EMBED_MODEL=BAAI/bge-m3
UPLOAD_DIR=data/uploads
SQLITE_PATH=data/meta.db
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
# Phase 4 (L22 RAGOps)
REDIS_URL=redis://localhost:6379/0
EMBED_QUANT=false
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:8080
LANGFUSE_PUBLIC_KEY=pk-lf-created-in-UI-settings
LANGFUSE_SECRET_KEY=sk-lf-created-in-UI-settings
EVAL_FLOOR=0.8
