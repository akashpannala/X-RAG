# X-RAG — all providers via .env (local / ssh VPS / online) — no Docker
# Copy to .env and fill only the providers you use. App auto-detects.

# --- App ---
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-in-env
JWT_EXPIRE_MIN=480
DEFAULT_MODE_BY_GROUP={"hr":"quick","eng":"deep","public":"quick"}
UPLOAD_DIR=data/uploads
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- LLM: groq (api) | ollama (local) | llama.cpp (local) ---
LLM_PROVIDER=groq
GROQ_API_KEY=sk-paste-your-groq-key-here
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-q4_0
LLAMA_CPP_URL=http://localhost:8080
LLAMA_CPP_MODEL=llama3.1:8b

# --- Embedding: bge (local) | choreo (remote/ssh) ---
EMBED_PROVIDER=bge
EMBED_MODEL=BAAI/bge-m3
EMBED_URL=
# EMBED_URL=https://your-choreo-choreoapps.dev/embed
# EMBED_URL=http://localhost:8002/embed  # ssh -L 8002:localhost:8002 vps

# --- Vector Store: qdrant (local/ssh/cloud) | supabase ---
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=offline_rag
QDRANT_API_KEY=
# For Qdrant Cloud: QDRANT_URL=https://xxx.qdrant.io  QDRANT_API_KEY=...
# For Supabase pgvector: set DATABASE_URL below + VECTOR_STORE_PROVIDER=supabase

# --- Database: sqlite (local) | postgres (local/ssh) | supabase (cloud) ---
SQLITE_PATH=data/meta.db
DATABASE_URL=
# DATABASE_URL=postgresql://user:pass@localhost:5432/xrag
# DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJ...

# --- Queue: none | redis (local/ssh) | upstash (cloud) ---
QUEUE_PROVIDER=none
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
